<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.aula.projetocursosfx.controller.MainController">

    <!-- MENU LATERAL -->

    <left>

        <VBox spacing="10"
              prefWidth="220"
              style="
                -fx-background-color: linear-gradient(to bottom,#1E3A8A,#2563EB);
                -fx-padding:20;
              ">

            <!-- LOGO -->

            <Label text="🎓 AcademiSys"
                   style="
                    -fx-text-fill:white;
                    -fx-font-size:22px;
                    -fx-font-weight:bold;
                   "/>

            <Label text="Sistema de Gestão de Cursos"
                   style="
                    -fx-text-fill:#D6E4FF;
                    -fx-font-size:11px;
                   "/>

            <!-- ESPAÇO -->

            <VBox spacing="8"
                  style="-fx-padding:20 0 0 0;">

                <Button text="👨‍🏫 Professores"
                        onAction="#abrirProfessor"
                        prefWidth="180"
                        style="
                            -fx-background-color:transparent;
                            -fx-text-fill:white;
                            -fx-font-size:14px;
                            -fx-alignment:CENTER_LEFT;
                        "/>

                <Button text="📚 Cursos"
                        onAction="#abrirCurso"
                        prefWidth="180"
                        style="
                            -fx-background-color:transparent;
                            -fx-text-fill:white;
                            -fx-font-size:14px;
                            -fx-alignment:CENTER_LEFT;
                        "/>

                <Button text="👨‍🎓 Alunos"
                        onAction="#abrirAluno"
                        prefWidth="180"
                        style="
                            -fx-background-color:transparent;
                            -fx-text-fill:white;
                            -fx-font-size:14px;
                            -fx-alignment:CENTER_LEFT;
                        "/>

                <Button text="📝 Matrículas"
                        onAction="#abrirMatricula"
                        prefWidth="180"
                        style="
                            -fx-background-color:transparent;
                            -fx-text-fill:white;
                            -fx-font-size:14px;
                            -fx-alignment:CENTER_LEFT;
                        "/>

            </VBox>

            <!-- EMPURRA O SAIR PARA BAIXO -->

            <VBox prefHeight="400"/>

            <Button text="🚪 Sair"
                    prefWidth="180"
                    style="
                        -fx-background-color:transparent;
                        -fx-text-fill:white;
                        -fx-font-size:14px;
                        -fx-alignment:CENTER_LEFT;
                    "/>

        </VBox>

    </left>

    <!-- ÁREA CENTRAL -->

    <center>

        <AnchorPane fx:id="contentPane"
                    style="-fx-background-color:#F5F7FA;">

            <children>

                <VBox layoutX="50"
                      layoutY="50"
                      spacing="15">

                    <Label text="Bem-vindo ao AcademiSys"
                           style="
                            -fx-font-size:28px;
                            -fx-font-weight:bold;
                            -fx-text-fill:#1E3A8A;
                           "/>

                    <Label text="Selecione uma opção no menu lateral."
                           style="
                            -fx-font-size:14px;
                            -fx-text-fill:#64748B;
                           "/>

                </VBox>

            </children>

        </AnchorPane>

    </center>

</BorderPane>