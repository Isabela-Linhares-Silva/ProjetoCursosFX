<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="188.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aula.projetocursosfx.controller.CadastrarAlunoController">
   <children>
      <Label layoutX="33.0" layoutY="35.0" text="Informe o nome do aluno:">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <Button layoutX="239.0" layoutY="133.0" mnemonicParsing="false" onMouseClicked="#onCadastrarAlunoClicked" text="Cadastrar" textFill="#059414" />
      <TextField fx:id="nomeAluno" layoutX="230.0" layoutY="33.0" prefHeight="26.0" prefWidth="221.0" promptText="Nome do aluno" />
      <Label layoutX="33.0" layoutY="82.0" text="Informe o e-mail do aluno:">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <TextField fx:id="emailAluno" layoutX="230.0" layoutY="81.0" prefHeight="26.0" prefWidth="221.0" promptText="e-mail do aluno" />
   </children>
</AnchorPane>
