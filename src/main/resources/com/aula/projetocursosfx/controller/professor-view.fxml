    <?import javafx.scene.control.Button?>
    <?import javafx.scene.control.Label?>
    <?import javafx.scene.control.TextField?>
    <?import javafx.scene.layout.AnchorPane?>
    <?import javafx.scene.layout.VBox?>
    <?import javafx.geometry.Insets?>

    <AnchorPane prefHeight="600.0"
                prefWidth="800.0"
                xmlns="http://javafx.com/javafx/21"
                xmlns:fx="http://javafx.com/fxml"
                fx:controller="com.aula.projetocursosfx.controller.ProfessorController"
                style="-fx-background-color: #F5F7FA;">

        <children>

            <VBox spacing="15"
                  AnchorPane.leftAnchor="40"
                  AnchorPane.topAnchor="40">

                <!-- TÍTULO -->

                <Label text="Cadastro de Professores"
                       style="
                   -fx-font-size:24px;
                   -fx-font-weight:bold;
                   -fx-text-fill:#1E3A8A;
                   "/>

                <!-- BUSCA -->

                <Label text="ID do Professor"
                       style="-fx-font-weight:bold;"/>

                <TextField fx:id="idProfessor"
                           promptText="Digite o ID para buscar"/>

                <Button text="Buscar"
                        onAction="#onBuscarProfessorClicked"
                        style="
                    -fx-background-color:#2563EB;
                    -fx-text-fill:white;
                    "/>

                <!-- NOME -->

                <Label text="Nome"
                       style="-fx-font-weight:bold;"/>

                <TextField fx:id="nomeProfessor"
                           promptText="Nome do professor"/>

                <!-- ESPECIALIDADE -->

                <Label text="Especialidade"
                       style="-fx-font-weight:bold;"/>

                <TextField fx:id="especialidadeProfessor"
                           promptText="Especialidade"/>

                <!-- BOTÕES -->

                <VBox spacing="10">

                    <Button text="Salvar"
                            onAction="#onCadastrarProfessorClicked"
                            style="
                        -fx-background-color:#10B981;
                        -fx-text-fill:white;
                        -fx-font-weight:bold;
                        "/>

                    <Button text="Atualizar"
                            onAction="#onAtualizarProfessorClicked"
                            style="
                        -fx-background-color:#F59E0B;
                        -fx-text-fill:white;
                        -fx-font-weight:bold;
                        "/>

                    <Button text="Limpar"
                            onAction="#onLimparClicked"
                            style="
                        -fx-background-color:#64748B;
                        -fx-text-fill:white;
                        -fx-font-weight:bold;
                        "/>

                </VBox>

            </VBox>

        </children>

    </AnchorPane>

