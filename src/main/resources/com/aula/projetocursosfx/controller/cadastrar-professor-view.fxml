<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="190.0" prefWidth="610.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aula.projetocursosfx.controller.CadastrarProfessorController">
   <children>
      <AnchorPane layoutX="10.0" layoutY="10.0" prefHeight="188.0" prefWidth="600.0">
         <children>
            <Label layoutX="14.0" layoutY="36.0" text="Informe o nome do professor:">
               <font>
                  <Font size="15.0" />
               </font>
            </Label>
            <Button layoutX="239.0" layoutY="133.0" mnemonicParsing="false" onAction="#onCadastrarProfessorClicked" onMouseClicked="#onCadastrarProfessorClicked" text="Cadastrar" textFill="#059414" />
            <TextField fx:id="nomeProfessor" layoutX="291.0" layoutY="34.0" prefHeight="26.0" prefWidth="221.0" promptText="Nome do professor" />
            <Label layoutX="14.0" layoutY="84.0" text="Informe a especialidade do professor:">
               <font>
                  <Font size="15.0" />
               </font>
            </Label>
            <TextField fx:id="especialidadeProfessor" layoutX="291.0" layoutY="81.0" prefHeight="26.0" prefWidth="221.0" promptText="Especialidade do professor" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
