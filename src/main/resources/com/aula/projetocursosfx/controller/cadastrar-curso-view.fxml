<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="282.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aula.projetocursosfx.controller.CadastrarCursoController">
   <children>
      <Label layoutX="33.0" layoutY="46.0" text="Digite o nome do Curso:">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <Button layoutX="252.0" layoutY="234.0" mnemonicParsing="false" onAction="#onCadastrarCursoClicked" text="Cadastrar" />
      <TextField fx:id="nomeCurso" layoutX="216.0" layoutY="44.0" prefHeight="26.0" prefWidth="233.0" promptText="Nome do curso" />
      <Label layoutX="33.0" layoutY="93.0" text="Digite a Carga Horaria:">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <Label layoutX="33.0" layoutY="139.0" text="Digite o Preço:">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <Label layoutX="33.0" layoutY="185.0" text="Professor:">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <TextField fx:id="cargaHorariaCurso" layoutX="216.0" layoutY="90.0" prefHeight="26.0" prefWidth="233.0" promptText="Carga Horaria" />
      <TextField fx:id="precoCurso" layoutX="216.0" layoutY="137.0" prefHeight="26.0" prefWidth="233.0" promptText="Valor R$" />
      <ComboBox fx:id="professores" layoutX="216.0" layoutY="182.0" prefHeight="26.0" prefWidth="233.0" promptText="Selecione o Professor" />
   </children>
</AnchorPane>
